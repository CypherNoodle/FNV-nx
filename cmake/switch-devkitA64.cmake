set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DEVKITPRO)
set(REXGLUE_PLATFORM_SWITCH ON CACHE BOOL "Horizon target" FORCE)
set(REXGLUE_ENABLE_TRACY OFF CACHE BOOL "" FORCE)
set(REXGLUE_ENABLE_PERF_COUNTERS OFF CACHE BOOL "" FORCE)
set(REXGLUE_USE_D3D12 OFF CACHE BOOL "" FORCE)
set(REXGLUE_USE_VULKAN ON CACHE BOOL "" FORCE)

if(NOT DEVKITPRO)
    set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "Native devkitPro installation path")
endif()
file(TO_CMAKE_PATH "${DEVKITPRO}" DEVKITPRO)
if(NOT EXISTS "${DEVKITPRO}/libnx/switch.specs")
    message(FATAL_ERROR "Pass -DDEVKITPRO=<native path containing devkitA64 and libnx>")
endif()
if(CMAKE_HOST_WIN32)
    set(_exe ".exe")
endif()
set(_bin "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-")
set(CMAKE_C_COMPILER "${_bin}gcc${_exe}")
set(CMAKE_CXX_COMPILER "${_bin}g++${_exe}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${_bin}gcc-ar${_exe}")
set(CMAKE_RANLIB "${_bin}gcc-ranlib${_exe}")
set(CMAKE_NM "${_bin}nm${_exe}")
set(CMAKE_OBJCOPY "${_bin}objcopy${_exe}")
set(CMAKE_STRIP "${_bin}strip${_exe}")
set(_arch "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIE -D__SWITCH__ -DNX -D_GNU_SOURCE -DSPDLOG_NO_TZ_OFFSET")
set(CMAKE_C_FLAGS_INIT "${_arch} -ffunction-sections -fdata-sections -ffp-contract=off -Wno-psabi")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_ASM_FLAGS_INIT "${_arch}")

# Resolve libnx's linker-script environment expression for native Windows CMake.
file(READ "${DEVKITPRO}/libnx/switch.specs" _specs)
string(REPLACE "%:getenv(DEVKITPRO /libnx/switch.ld)" "${DEVKITPRO}/libnx/switch.ld" _specs "${_specs}")
file(WRITE "${CMAKE_BINARY_DIR}/switch.specs" "${_specs}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "\"-specs=${CMAKE_BINARY_DIR}/switch.specs\" -Wl,--gc-sections -Wl,--no-relax")
include_directories(SYSTEM "${DEVKITPRO}/libnx/include" "${DEVKITPRO}/portlibs/switch/include")
link_directories("${DEVKITPRO}/libnx/lib" "${DEVKITPRO}/portlibs/switch/lib")
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/devkitA64" "${DEVKITPRO}/libnx" "${DEVKITPRO}/portlibs/switch")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
